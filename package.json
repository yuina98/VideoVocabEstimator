{
  "name": "video-vocab-estimator",
  "version": "0.1.0",
  "private": true,
  "description": "通过视频网站字幕数据估算视频所需词汇量的 Chrome 扩展 (MV3 + TypeScript)",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "measure": "esbuild scripts/measure.ts --bundle --platform=node --format=esm --outfile=.cache/measure.mjs --log-level=error && node .cache/measure.mjs",
    "tune": "esbuild scripts/tune-difficulty.ts --bundle --platform=node --format=esm --outfile=.cache/tune.mjs --log-level=error && node .cache/tune.mjs",
    "gen:bnc": "node scripts/generate-bnc.mjs",
    "gen:proper-nouns": "node scripts/generate-proper-nouns.mjs",
    "gen:range-list": "node scripts/generate-range-list.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  },
  "dependencies": {
    "compromise": "^14.16.0"
  }
}
